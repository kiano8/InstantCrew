# Copy to .env for local dev. In production this lives at /etc/instantcrew/instantcrew.env
# (root:root 600) — see deploy/install-env.sh. Never commit real values.

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=instantcrew
DB_PASSWORD=
DB_NAME=instantcrew
DB_SSLMODE=disable

# GCash Verifier Database
VERIFIER_DB_HOST=127.0.0.1
VERIFIER_DB_PORT=5432
VERIFIER_DB_USER=
VERIFIER_DB_PASSWORD=
VERIFIER_DB_NAME=
VERIFIER_DB_SSLMODE=disable

# Application Settings
HOST=127.0.0.1
PORT=8080
ENV=prod
SESSION_IDLE_MINUTES=30
BETA_MAX_USERS=
COOKIE_SECURE=true

# Admin Accounts
ADMIN_EMAIL=
ADMIN_PASSWORD=
ACCOUNTING_EMAIL=
ACCOUNTING_PASSWORD=

# Email for signup verification codes and password resets. With Gmail, turn on
# 2-Step Verification for the sending account and create an App Password at
# https://myaccount.google.com/apppasswords (a normal Gmail password is refused).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Instant Crew

# Web Push for employer notifications. Generate once with `go run ./cmd/vapid` and
# never rotate casually: new keys break every device's existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@instantcrew.com

# Google OAuth (if configured)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URL=
